# Production store secrets. Copy to .env.prod (gitignored); docker-compose.prod.yml
# loads it automatically. Leave a value empty to keep that integration disabled.

# Mana Pool API (order import + cron sync)
MANAPOOL_EMAIL=
MANAPOOL_API_TOKEN=

# Inbound mutation surfaces fail closed when these are unset (SAS-001).
MANAPOOL_WEBHOOK_SECRET=
CRON_SECRET=
