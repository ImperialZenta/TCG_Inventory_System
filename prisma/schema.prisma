generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Reference data
// ---------------------------------------------------------------------------

model Language {
  scryfallCode String  @id
  manapoolCode String?
  label        String
  localOnly    Boolean @default(false)
}

// ---------------------------------------------------------------------------
// Physical storage: Shelf → Bin → Block
// ---------------------------------------------------------------------------

model Shelf {
  id        String   @id @default(cuid())
  code      String   @unique
  label     String?
  sortOrder Int      @default(0)
  bins      Bin[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Bin {
  id        String   @id @default(cuid())
  binId     String   @unique
  shelfId   String?
  shelf     Shelf?   @relation(fields: [shelfId], references: [id], onDelete: SetNull)
  label     String?
  sortOrder Int      @default(0)
  blocks    Block[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shelfId])
}

model BinSequence {
  id      String @id @default("default")
  nextNum Int    @default(1)
}

// ---------------------------------------------------------------------------
// Chaos blocks
// ---------------------------------------------------------------------------

enum BlockStatus {
  OPEN
  SEALED
  ACTIVE
  ARCHIVED
  LIQUIDATED
}

enum BlockTier {
  GENERAL
  BULK_COMMONS
  TRADE_IN
  MYSTERY_ELIGIBLE
  HIGH_VALUE_HOLD
}

enum BlockChannel {
  MANAPOOL
  EBAY
  TCGPLAYER
}

model Block {
  id          String       @id @default(cuid())
  blockId     String       @unique
  label       String?
  status      BlockStatus  @default(OPEN)
  tier        BlockTier    @default(GENERAL)
  channel     BlockChannel @default(MANAPOOL)
  binId       String?
  bin         Bin?         @relation(fields: [binId], references: [id])
  packedAt    DateTime     @default(now())
  sealedAt    DateTime?
  lastPickAt  DateTime?
  activatedAt DateTime?
  targetCount Int?
  notes       String?
  pickHoldAt     DateTime?
  pickHoldReason String?
  cards       CardLine[]
  pickItems       PickItem[]
  pickHistory     PickHistory[]
  inventoryEvents InventoryEvent[]
  createdAt       DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
  @@index([channel])
  @@index([lastPickAt])
  @@index([packedAt])
  @@index([binId])
}

enum Condition {
  NM
  LP
  MP
  HP
  DMG
}

enum Finish {
  NONFOIL
  FOIL
  ETCHED
}

model CardLine {
  id              String     @id @default(cuid())
  blockId         String
  block           Block      @relation(fields: [blockId], references: [id], onDelete: Cascade)
  scryfallId      String?
  name            String
  setCode         String
  collectorNumber String?
  finish          Finish     @default(NONFOIL)
  language        String     @default("en")
  condition       Condition  @default(NM)
  quantity        Int        @default(1)
  position        Int
  isBulkLine      Boolean    @default(false)
  bulkDescription String?
  priceCents      Int?
  imageUri        String?
  addedAt         DateTime   @default(now())
  pickItems       PickItem[]

  @@unique([blockId, position])
  @@index([name])
  @@index([setCode])
  @@index([scryfallId])
  @@index([language, condition, finish])
}

// ---------------------------------------------------------------------------
// Staging (pre-block intake)
// ---------------------------------------------------------------------------

enum StagingImportStatus {
  PARSED
  ASSIGNED
  ARCHIVED
}

enum StagingImportKind {
  TRADE_IN
  CORRECTION
}

model StagingImport {
  id         String              @id @default(cuid())
  filename   String
  rowCount   Int                 @default(0)
  status     StagingImportStatus @default(PARSED)
  kind       StagingImportKind   @default(TRADE_IN)
  targetCount Int?
  sourcePickListId String?
  sourceMtgBlockId String?
  sourceNotes      String?
  cards           StagingCard[]
  inventoryEvents InventoryEvent[]
  createdAt       DateTime            @default(now())
}

model StagingCard {
  id              String        @id @default(cuid())
  stagingImportId String
  stagingImport   StagingImport @relation(fields: [stagingImportId], references: [id], onDelete: Cascade)
  scryfallId      String?
  name            String
  setCode         String
  collectorNumber String?
  finish          Finish        @default(NONFOIL)
  language        String        @default("en")
  condition       Condition     @default(NM)
  quantity        Int           @default(1)
  position        Int?
  expansionIndex  Int?
  suggestedBlock  Int?
  assignedBlockId String?
  sourceRow       Int?
  priceCents      Int?
  imageUri        String?
  createdAt       DateTime      @default(now())

  @@index([stagingImportId])
  @@index([stagingImportId, suggestedBlock, position])
}

// ---------------------------------------------------------------------------
// Mana Pool orders (cached for offline picking)
// ---------------------------------------------------------------------------

enum ExternalOrderStatus {
  IMPORTED
  PICKING
  PICKED
  CANCELLED
}

model ExternalOrder {
  id              String              @id @default(cuid())
  manapoolOrderId String              @unique
  reference       String?
  status          ExternalOrderStatus @default(IMPORTED)
  importedAt      DateTime            @default(now())
  pickedAt        DateTime?
  lines           ExternalOrderLine[]
  pickListId      String?
  pickList        PickList?           @relation(fields: [pickListId], references: [id])
  inventoryEvents InventoryEvent[]
}

model ExternalOrderLine {
  id              String        @id @default(cuid())
  externalOrderId String
  externalOrder   ExternalOrder @relation(fields: [externalOrderId], references: [id], onDelete: Cascade)
  scryfallId      String?
  name            String
  setCode         String?
  collectorNumber String?
  condition       Condition     @default(NM)
  finish          Finish        @default(NONFOIL)
  language        String        @default("en")
  quantity        Int           @default(1)
  priceCents      Int?
  manapoolLineId  String?
  pickItems       PickItem[]
}

// ---------------------------------------------------------------------------
// Picking
// ---------------------------------------------------------------------------

enum PickStatus {
  PENDING
  PICKED
  SHORT
  SUBSTITUTED
}

enum PickListStatus {
  OPEN
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

model PickList {
  id          String         @id @default(cuid())
  pickListId  String         @unique
  status      PickListStatus @default(OPEN)
  holdReason  String?
  sourceLabel String?
  notes       String?
  pickerCount Int            @default(1)
  items       PickItem[]
  waves       PickWave[]
  pickHistory PickHistory[]
  orders          ExternalOrder[]
  inventoryEvents InventoryEvent[]
  createdAt       DateTime       @default(now())
  completedAt     DateTime?
}

model PickWave {
  id         String     @id @default(cuid())
  pickListId String
  pickList   PickList   @relation(fields: [pickListId], references: [id], onDelete: Cascade)
  waveNumber Int
  label      String?
  items      PickItem[]
}

model PickItem {
  id                   String             @id @default(cuid())
  pickListId           String
  pickList             PickList           @relation(fields: [pickListId], references: [id], onDelete: Cascade)
  pickWaveId           String?
  pickWave             PickWave?          @relation(fields: [pickWaveId], references: [id])
  cardLineId           String?
  cardLine             CardLine?          @relation(fields: [cardLineId], references: [id], onDelete: SetNull)
  blockId              String?
  block                Block?             @relation(fields: [blockId], references: [id], onDelete: SetNull)
  externalOrderId      String?
  externalOrderLineId  String?
  externalOrderLine    ExternalOrderLine? @relation(fields: [externalOrderLineId], references: [id], onDelete: SetNull)
  quantity             Int                @default(1)
  status               PickStatus         @default(PENDING)
  shortReason          String?
  /** Set when the allocated block is quarantined; cleared on clear/reallocate. */
  blockedReason        String?
  notes                String?

  @@index([pickListId])
  @@index([blockId])
  @@index([cardLineId])
}

model PickHistory {
  id                String     @id @default(cuid())
  blockId           String?
  block             Block?     @relation(fields: [blockId], references: [id], onDelete: SetNull)
  mtgBlockId        String
  blockTierAtPick   BlockTier?
  positionAtPick    Int
  scryfallId        String?
  name              String
  setCode           String
  collectorNumber   String?
  condition         Condition
  finish            Finish
  language          String
  pickListId        String
  pickList          PickList   @relation(fields: [pickListId], references: [id], onDelete: Cascade)
  pickItemId        String?    @unique
  externalOrderId   String?
  isCounterPick     Boolean    @default(false)
  dwellDays         Int?
  pickedAt          DateTime   @default(now())

  @@index([blockId])
  @@index([pickListId])
  @@index([pickedAt])
}

// ---------------------------------------------------------------------------
// Inventory event log (append-only audit trail)
// ---------------------------------------------------------------------------

model InventoryEvent {
  id              String         @id @default(cuid())
  eventType       String
  summary         String
  payload         Json
  correlationId   String?
  blockId         String?
  block           Block?         @relation(fields: [blockId], references: [id], onDelete: SetNull)
  stagingImportId String?
  stagingImport   StagingImport? @relation(fields: [stagingImportId], references: [id], onDelete: SetNull)
  pickListId      String?
  pickList        PickList?      @relation(fields: [pickListId], references: [id], onDelete: SetNull)
  externalOrderId String?
  externalOrder   ExternalOrder? @relation(fields: [externalOrderId], references: [id], onDelete: SetNull)
  actor           String?
  createdAt       DateTime       @default(now())

  @@index([createdAt])
  @@index([eventType])
  @@index([blockId])
  @@index([correlationId])
  @@index([stagingImportId])
}

model BlockSequence {
  id      String @id @default("mtg")
  nextNum Int    @default(1)
  prefix  String @default("MTG")
}

model PickListSequence {
  id      String @id @default("pick")
  nextNum Int    @default(1)
  prefix  String @default("PICK")
}

model AppSetting {
  key   String @id
  value String
}
