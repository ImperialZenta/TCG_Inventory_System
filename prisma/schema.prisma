generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Reference data
// ---------------------------------------------------------------------------

model Language {
  scryfallCode String  @id
  manapoolCode String?
  label        String
  localOnly    Boolean @default(false)
}

// ---------------------------------------------------------------------------
// Physical storage: Shelf → Bin → Block
// ---------------------------------------------------------------------------

model Shelf {
  id        String   @id @default(cuid())
  code      String   @unique
  label     String?
  sortOrder Int      @default(0)
  bins      Bin[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Bin {
  id                  String              @id @default(cuid())
  binId                 String              @unique
  shelfId               String?
  shelf                 Shelf?              @relation(fields: [shelfId], references: [id], onDelete: SetNull)
  label                 String?
  sortOrder             Int                 @default(0)
  blocks                Block[]
  stockItems            StockItem[]
  catalogMemberships    ChannelCatalogBin[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([shelfId])
}

model ChannelCatalog {
  id        String              @id @default(cuid())
  channel   BlockChannel
  label     String
  bins      ChannelCatalogBin[]
  createdAt DateTime            @default(now())

  @@index([channel])
}

model ChannelCatalogBin {
  id        String         @id @default(cuid())
  catalogId String
  catalog   ChannelCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  binId     String
  bin       Bin            @relation(fields: [binId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([catalogId, binId])
  @@index([binId])
}

model BinSequence {
  id      String @id @default("default")
  nextNum Int    @default(1)
}

// ---------------------------------------------------------------------------
// Chaos blocks
// ---------------------------------------------------------------------------

enum BlockStatus {
  OPEN
  SEALED
  ACTIVE
  ARCHIVED
  LIQUIDATED
}

enum BlockTier {
  GENERAL
  BULK_COMMONS
  TRADE_IN
  MYSTERY_ELIGIBLE
  HIGH_VALUE_HOLD
}

enum BlockChannel {
  MANAPOOL
  EBAY
  TCGPLAYER
}

model Block {
  id          String       @id @default(cuid())
  blockId     String       @unique
  label       String?
  status      BlockStatus  @default(OPEN)
  tier        BlockTier    @default(GENERAL)
  channel     BlockChannel @default(MANAPOOL)
  binId       String?
  bin         Bin?         @relation(fields: [binId], references: [id])
  packedAt    DateTime     @default(now())
  sealedAt    DateTime?
  lastPickAt  DateTime?
  activatedAt DateTime?
  targetCount Int?
  notes       String?
  pickHoldAt     DateTime?
  pickHoldReason String?
  reservedUploadSessionId String?
  reservedUploadSession   UploadSession? @relation(fields: [reservedUploadSessionId], references: [id], onDelete: SetNull)
  uploadSessionBlocks     UploadSessionBlock[]
  cards       CardLine[]
  pickItems       PickItem[]
  pickHistory     PickHistory[]
  inventoryEvents InventoryEvent[]
  createdAt       DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
  @@index([reservedUploadSessionId])
  @@index([channel])
  @@index([lastPickAt])
  @@index([packedAt])
  @@index([binId])
}

enum Condition {
  NM
  LP
  MP
  HP
  DMG
}

enum Finish {
  NONFOIL
  FOIL
  ETCHED
}

model CardLine {
  id              String     @id @default(cuid())
  blockId         String
  block           Block      @relation(fields: [blockId], references: [id], onDelete: Cascade)
  scryfallId      String?
  name            String
  setCode         String
  collectorNumber String?
  finish          Finish     @default(NONFOIL)
  language        String     @default("en")
  condition       Condition  @default(NM)
  quantity        Int        @default(1)
  position        Int
  isBulkLine      Boolean    @default(false)
  bulkDescription String?
  priceCents      Int?
  imageUri        String?
  addedAt         DateTime   @default(now())
  pickItems       PickItem[]

  @@unique([blockId, position])
  @@index([name])
  @@index([setCode])
  @@index([scryfallId])
  @@index([language, condition, finish])
}

// ---------------------------------------------------------------------------
// Staging (pre-block intake)
// ---------------------------------------------------------------------------

enum StagingImportStatus {
  PARSED
  ASSIGNED
  ARCHIVED
}

enum StagingImportKind {
  TRADE_IN
  CORRECTION
}

model StagingImport {
  id         String              @id @default(cuid())
  filename   String
  rowCount   Int                 @default(0)
  status     StagingImportStatus @default(PARSED)
  kind       StagingImportKind   @default(TRADE_IN)
  targetCount Int?
  sourcePickListId String?
  sourceMtgBlockId String?
  sourceNotes      String?
  cards           StagingCard[]
  inventoryEvents InventoryEvent[]
  createdAt       DateTime            @default(now())
}

model StagingCard {
  id              String        @id @default(cuid())
  stagingImportId String
  stagingImport   StagingImport @relation(fields: [stagingImportId], references: [id], onDelete: Cascade)
  scryfallId      String?
  name            String
  setCode         String
  collectorNumber String?
  finish          Finish        @default(NONFOIL)
  language        String        @default("en")
  condition       Condition     @default(NM)
  quantity        Int           @default(1)
  position        Int?
  expansionIndex  Int?
  suggestedBlock  Int?
  assignedBlockId String?
  sourceRow       Int?
  priceCents      Int?
  imageUri        String?
  createdAt       DateTime      @default(now())

  @@index([stagingImportId])
  @@index([stagingImportId, suggestedBlock, position])
}

// ---------------------------------------------------------------------------
// Mana Pool orders (cached for offline picking)
// ---------------------------------------------------------------------------

enum ExternalOrderStatus {
  IMPORTED
  PICKING
  PICKED
  CANCELLED
}

model ExternalOrder {
  id              String              @id @default(cuid())
  manapoolOrderId String              @unique
  reference       String?
  status          ExternalOrderStatus @default(IMPORTED)
  channelId       String?
  channel         Channel?            @relation(fields: [channelId], references: [id], onDelete: SetNull)
  importedAt      DateTime            @default(now())
  pickedAt        DateTime?
  lines           ExternalOrderLine[]
  pickListId      String?
  pickList        PickList?           @relation(fields: [pickListId], references: [id])
  inventoryEvents InventoryEvent[]
  oversellIncidentOrders OversellIncidentOrder[]

  @@index([channelId])
}

model ExternalOrderLine {
  id              String        @id @default(cuid())
  externalOrderId String
  externalOrder   ExternalOrder @relation(fields: [externalOrderId], references: [id], onDelete: Cascade)
  scryfallId      String?
  name            String
  setCode         String?
  collectorNumber String?
  condition       Condition     @default(NM)
  finish          Finish        @default(NONFOIL)
  language        String        @default("en")
  quantity        Int           @default(1)
  priceCents      Int?
  manapoolLineId  String?
  stockItemId     String?
  stockItem       StockItem?    @relation(fields: [stockItemId], references: [id], onDelete: SetNull)
  unmatched       Boolean       @default(false)
  oversellFlag    Boolean       @default(false)
  pickItems       PickItem[]

  @@index([stockItemId])
}

// ---------------------------------------------------------------------------
// Picking
// ---------------------------------------------------------------------------

enum PickStatus {
  PENDING
  PICKED
  SHORT
  SUBSTITUTED
}

enum PickListStatus {
  OPEN
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

model PickList {
  id          String         @id @default(cuid())
  pickListId  String         @unique
  status      PickListStatus @default(OPEN)
  holdReason  String?
  sourceLabel String?
  notes       String?
  pickerCount Int            @default(1)
  items       PickItem[]
  waves       PickWave[]
  pickHistory PickHistory[]
  orders          ExternalOrder[]
  inventoryEvents InventoryEvent[]
  createdAt       DateTime       @default(now())
  completedAt     DateTime?
}

model PickWave {
  id         String     @id @default(cuid())
  pickListId String
  pickList   PickList   @relation(fields: [pickListId], references: [id], onDelete: Cascade)
  waveNumber Int
  label      String?
  items      PickItem[]
}

model PickItem {
  id                   String             @id @default(cuid())
  pickListId           String
  pickList             PickList           @relation(fields: [pickListId], references: [id], onDelete: Cascade)
  pickWaveId           String?
  pickWave             PickWave?          @relation(fields: [pickWaveId], references: [id])
  cardLineId           String?
  cardLine             CardLine?          @relation(fields: [cardLineId], references: [id], onDelete: SetNull)
  blockId              String?
  block                Block?             @relation(fields: [blockId], references: [id], onDelete: SetNull)
  externalOrderId      String?
  externalOrderLineId  String?
  externalOrderLine    ExternalOrderLine? @relation(fields: [externalOrderLineId], references: [id], onDelete: SetNull)
  quantity             Int                @default(1)
  status               PickStatus         @default(PENDING)
  shortReason          String?
  /** Set when the allocated block is quarantined; cleared on clear/reallocate. */
  blockedReason        String?
  notes                String?

  @@index([pickListId])
  @@index([blockId])
  @@index([cardLineId])
}

model PickHistory {
  id                String     @id @default(cuid())
  blockId           String?
  block             Block?     @relation(fields: [blockId], references: [id], onDelete: SetNull)
  mtgBlockId        String
  blockTierAtPick   BlockTier?
  positionAtPick    Int
  scryfallId        String?
  name              String
  setCode           String
  collectorNumber   String?
  condition         Condition
  finish            Finish
  language          String
  pickListId        String
  pickList          PickList   @relation(fields: [pickListId], references: [id], onDelete: Cascade)
  pickItemId        String?    @unique
  externalOrderId   String?
  isCounterPick     Boolean    @default(false)
  dwellDays         Int?
  pickedAt          DateTime   @default(now())

  @@index([blockId])
  @@index([pickListId])
  @@index([pickedAt])
}

// ---------------------------------------------------------------------------
// Inventory event log (append-only audit trail)
// ---------------------------------------------------------------------------

model InventoryEvent {
  id              String         @id @default(cuid())
  eventType       String
  summary         String
  payload         Json
  correlationId   String?
  blockId         String?
  block           Block?         @relation(fields: [blockId], references: [id], onDelete: SetNull)
  stockItemId     String?
  stockItem       StockItem?     @relation(fields: [stockItemId], references: [id], onDelete: SetNull)
  stagingImportId String?
  stagingImport   StagingImport? @relation(fields: [stagingImportId], references: [id], onDelete: SetNull)
  pickListId      String?
  pickList        PickList?      @relation(fields: [pickListId], references: [id], onDelete: SetNull)
  externalOrderId String?
  externalOrder   ExternalOrder? @relation(fields: [externalOrderId], references: [id], onDelete: SetNull)
  uploadSessionId String?
  uploadSession   UploadSession? @relation(fields: [uploadSessionId], references: [id], onDelete: SetNull)
  actor           String?
  createdAt       DateTime       @default(now())

  @@index([createdAt])
  @@index([eventType])
  @@index([blockId])
  @@index([stockItemId])
  @@index([correlationId])
  @@index([stagingImportId])
  @@index([uploadSessionId])
}

// ---------------------------------------------------------------------------
// Sorted stock (Epic 10 — ADR-004 append-only ledger)
// ---------------------------------------------------------------------------

enum StockMovementReason {
  RECEIVE
  PROMOTE
  SALE
  RETURN
  COUNT_ADJUST
  TRANSFER
  RESERVE
  RELEASE
  DAMAGE
}

enum StockReservationStatus {
  ACTIVE
  RELEASED
  COMMITTED
  EXPIRED
}

enum StockReservationReleaseReason {
  CANCEL
  EXPIRED
  COMMITTED
}

model StockItem {
  id               String          @id @default(cuid())
  gameId           String          @default("mtg")
  catalogCardId    String
  name             String
  setCode          String
  collectorNumber  String          @default("")
  finish           Finish
  language         String          @default("en")
  condition        Condition
  onHandQuantity   Int             @default(0)
  reservedQuantity Int             @default(0)
  costBasisCents   Int?
  marketPriceCents Int?
  catalogImageUri  String?
  binId            String?
  bin              Bin?            @relation(fields: [binId], references: [id], onDelete: SetNull)
  movements        StockMovement[]
  reservations     StockReservation[]
  channelListings  ChannelListing[]
  externalOrderLines ExternalOrderLine[]
  oversellIncidents OversellIncident[]
  inventoryEvents  InventoryEvent[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([gameId, catalogCardId, setCode, collectorNumber, finish, language, condition])
  @@index([name])
  @@index([setCode])
  @@index([catalogCardId])
  @@index([binId])
}

model StockMovement {
  id            String              @id @default(cuid())
  stockItemId   String
  stockItem     StockItem           @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  delta         Int
  reason        StockMovementReason
  referenceType String?
  referenceId   String?
  actor         String?
  createdAt     DateTime            @default(now())

  @@index([stockItemId, createdAt])
}

model StockReservation {
  id            String                         @id @default(cuid())
  stockItemId   String
  stockItem     StockItem                      @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  quantity      Int
  referenceType String
  referenceId   String
  status        StockReservationStatus         @default(ACTIVE)
  expiresAt     DateTime
  releaseReason StockReservationReleaseReason?
  actor         String?
  createdAt     DateTime                       @default(now())
  updatedAt     DateTime                       @updatedAt

  @@unique([referenceType, referenceId, stockItemId])
  @@index([expiresAt, status])
}

// ---------------------------------------------------------------------------
// Sales channels & sync (Epic 14 — ADR-007, ADR-008)
// ---------------------------------------------------------------------------

enum ChannelType {
  MANAPOOL
  SHOPIFY
  EBAY
  TCGPLAYER
}

enum ChannelSyncMode {
  MANUAL_CSV
  ONE_WAY_PUSH
  TWO_WAY
}

enum ChannelListingStatus {
  ACTIVE
  DELISTED
  ERROR
}

enum ChannelOutboxOperation {
  UPSERT_LISTING
  UPDATE_QTY
  UPDATE_PRICE
  DELIST
}

enum ChannelOutboxStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum OversellIncidentStatus {
  OPEN
  RESOLVED
}

enum OversellResolution {
  FULFILLED_ALT
  PROMOTED
  CANCELLED_REFUND
}

model Channel {
  id               String          @id @default(cuid())
  name             String
  type             ChannelType
  syncMode         ChannelSyncMode @default(ONE_WAY_PUSH)
  enabled          Boolean         @default(true)
  paused           Boolean         @default(false)
  reserveBufferQty Int             @default(0)
  credentials      Json?
  settings         Json?
  listings         ChannelListing[]
  outbox           ChannelOutbox[]
  externalOrders   ExternalOrder[]
  oversellIncidentOrders OversellIncidentOrder[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([type])
  @@index([enabled, paused])
}

model ChannelListing {
  id                 String               @id @default(cuid())
  channelId          String
  channel            Channel              @relation(fields: [channelId], references: [id], onDelete: Cascade)
  stockItemId        String
  stockItem          StockItem            @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  externalListingId  String?
  lastSyncedQty      Int?
  lastSyncedAt       DateTime?
  status             ChannelListingStatus @default(ACTIVE)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@unique([channelId, stockItemId])
  @@index([stockItemId])
  @@index([status])
}

model ChannelOutbox {
  id             String                 @id @default(cuid())
  channelId      String
  channel        Channel                @relation(fields: [channelId], references: [id], onDelete: Cascade)
  operation      ChannelOutboxOperation
  payload        Json
  status         ChannelOutboxStatus    @default(PENDING)
  attempts       Int                    @default(0)
  lastError      String?
  idempotencyKey String
  createdAt      DateTime               @default(now())
  processedAt    DateTime?

  @@unique([idempotencyKey])
  @@index([status, createdAt])
  @@index([channelId])
}

model OversellIncident {
  id             String                 @id @default(cuid())
  stockItemId    String
  stockItem      StockItem              @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  status         OversellIncidentStatus @default(OPEN)
  resolution     OversellResolution?
  resolutionNote String?
  resolvedAt     DateTime?
  resolvedBy     String?
  orders         OversellIncidentOrder[]
  createdAt      DateTime               @default(now())

  @@index([status])
  @@index([stockItemId])
  @@index([createdAt])
}

model OversellIncidentOrder {
  id              String            @id @default(cuid())
  incidentId      String
  incident        OversellIncident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  channelId       String
  channel         Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  externalOrderId String?
  externalOrder   ExternalOrder?    @relation(fields: [externalOrderId], references: [id], onDelete: SetNull)
  channelOrderRef String

  @@index([incidentId])
  @@index([channelId])
}

// ---------------------------------------------------------------------------
// Upload sessions (block-mode marketplace listing — ADR-013)
// ---------------------------------------------------------------------------

enum UploadSessionStatus {
  DRAFT
  CSV_READY
  COMPLETED
  CANCELLED
}

model UploadSessionSequence {
  id      String @id @default("upload")
  nextNum Int    @default(1)
  prefix  String @default("UP")
}

model UploadSession {
  id             String              @id @default(cuid())
  sessionId      String              @unique
  channel        BlockChannel
  status         UploadSessionStatus @default(DRAFT)
  createdBy      String?
  csvGeneratedAt DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  blocks         UploadSessionBlock[]
  reservedBlocks Block[]
  exportAudits   UploadExportAudit[]
  inventoryEvents InventoryEvent[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([status])
  @@index([createdAt])
}

model UploadSessionBlock {
  id        String        @id @default(cuid())
  sessionId String
  session   UploadSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  blockId   String
  block     Block         @relation(fields: [blockId], references: [id])
  addedAt   DateTime      @default(now())

  @@unique([sessionId, blockId])
  @@index([blockId])
}

model UploadExportAudit {
  id        String        @id @default(cuid())
  sessionId String
  session   UploadSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  rowCount  Int
  blockIds  String[]
  filename  String
  actor     String?
  createdAt DateTime      @default(now())

  @@index([sessionId])
}

model BlockSequence {
  id      String @id @default("mtg")
  nextNum Int    @default(1)
  prefix  String @default("MTG")
}

model PickListSequence {
  id      String @id @default("pick")
  nextNum Int    @default(1)
  prefix  String @default("PICK")
}

model AppSetting {
  key   String @id
  value String
}

// ---------------------------------------------------------------------------
// Access control (ACC-001) — tenant-shaped for ADR-010
// ---------------------------------------------------------------------------

enum MembershipRole {
  OWNER
  MANAGER
  STAFF
  READ_ONLY
}

model Organization {
  id        String                   @id @default(cuid())
  slug      String                   @unique @default("default")
  name      String
  createdAt DateTime                 @default(now())
  members   OrganizationMembership[]
}

model User {
  id           String                   @id @default(cuid())
  email        String                   @unique
  passwordHash String
  displayName  String
  enabled      Boolean                  @default(true)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  memberships  OrganizationMembership[]
  sessions     Session[]
}

model OrganizationMembership {
  id             String         @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
