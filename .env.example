# PostgreSQL (Docker default)
DATABASE_URL="postgresql://tcg:tcg@localhost:5432/tcg_inventory"

# Stale block threshold in days
STALE_BLOCK_DAYS=90

# Mana Pool API (optional — order import / listing push)
MANAPOOL_EMAIL=
MANAPOOL_API_TOKEN=
MANAPOOL_WEBHOOK_SECRET=
CRON_SECRET=

# Local dev only — allow inbound webhook/cron without secrets (SAS-001)
ALLOW_INSECURE_INBOUND=false

# Set to true on first run: docker compose run -e RUN_SEED=true app
# (or use: docker compose exec app npm run db:seed)
RUN_SEED=false
